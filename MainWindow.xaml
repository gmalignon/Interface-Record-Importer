<Window x:Class="InterfaceRecordImporter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:InterfaceRecordImporter"
        xmlns:tb="http://www.hardcodet.net/taskbar"
        mc:Ignorable="d"
        Title="SmartAgent GDS Record Importer" Height="700" Width="600" 
        ResizeMode="CanMinimize" WindowStartupLocation="CenterScreen" SizeToContent="Width" 
        WindowStyle="None" AllowsTransparency="True" Icon="Resources/Icon_Blue.ico" ShowInTaskbar="False">
    <Window.Effect>
        <DropShadowEffect/>
    </Window.Effect>
    <Window.Background>
        <SolidColorBrush Opacity="0" Color="White"/>
    </Window.Background>
    <Viewbox>
        <Border Background="White" CornerRadius="20"  BorderThickness="2,2,2,2" BorderBrush="Black"  Padding="5"  Margin="5">
            <Grid  Width="600" Margin="10">
                <Grid.Resources>
                    <local:Window_Settings  x:Key="WindowCommand" />
                </Grid.Resources>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*"  />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="50"  />
                    <RowDefinition Height="80" />
                    <RowDefinition Height="250" />
                    <RowDefinition Height="45" />
                    <RowDefinition Height="45" />
                </Grid.RowDefinitions>
                <Grid Grid.Column="1" Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*"  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"  />
                    </Grid.RowDefinitions>
                    <Button  Name="Button_Minimize" Grid.Column="1" Grid.Row="0" Content="_" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center" Width="30" FontSize="20" Height="30"  FontWeight="Bold" Click="Button_Minimize_Click"/>
                    <Button  Name="Button_Close" Grid.Column="1" Grid.Row="0" Content="X" HorizontalAlignment="Right" Margin="0" Width="30" FontSize="20" Height="30"  FontWeight="Bold" Foreground="#FF9C0000" Click="Button_Close_Click" VerticalContentAlignment="Center" VerticalAlignment="Center" HorizontalContentAlignment="Center" />
                </Grid>
                <Grid Grid.Column="0" Grid.ColumnSpan="1" Grid.Row="0" Margin="10,0,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="*"  />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="50"  />
                    </Grid.RowDefinitions>
                    <Label Grid.Column="0"  Foreground="#FF042271" Grid.Row="0" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Left" FontSize="10">Powered By</Label>
                    <Image  Grid.Column="1"  Grid.Row="0" HorizontalAlignment="Left" Margin="0" VerticalAlignment="Center" Source="/UCDLogo.png" Width="100"/>
                </Grid>

                <Border Name="Border_Logo" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="1" Background="White" CornerRadius="5"  BorderThickness="1" BorderBrush="DarkGray"  Padding="5"  Margin="5">
                    <Grid >
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*"  />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*"  />
                        </Grid.RowDefinitions>
                        <Label Content="TAAS GDS Record Importer" HorizontalAlignment="Left" VerticalContentAlignment="Center" FontWeight="Bold" FontStyle="Italic"/>
                        <Image x:Name="Exito"  HorizontalAlignment="Center" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"   Margin="0" VerticalAlignment="Center" Source="/Resources/NondiaLogo.png" Width="120"/>
                        <Label Name="Label_ProductInfo" Grid.Row="0" Grid.Column="1" Foreground="#FF042271"  FontStyle="Italic" FontWeight="Bold" HorizontalAlignment="Right" HorizontalContentAlignment="Right" FontSize="9"/>
                    </Grid>
                </Border>
                <Border Name="Border_Record" Grid.Column="0" Grid.Row="2"  Grid.ColumnSpan="2" Background="White" CornerRadius="5"  BorderThickness="1" BorderBrush="DarkGray"  Padding="5"  Margin="5">
                    <TextBlock Name="TextBlock_Record" TextWrapping="WrapWithOverflow" FontSize="10" ></TextBlock>
                </Border>

                <Border Name="Border_Status" Grid.Column="0" Grid.Row="3"  Grid.ColumnSpan="2" Background="White" CornerRadius="5"  BorderThickness="1" BorderBrush="DarkGray"  Padding="5"  Margin="5">
                    <TextBox Name="TextBox_Status" FontStyle="Italic" FontWeight="Bold" IsReadOnly="True" SelectionOpacity="0" VerticalContentAlignment="Stretch" HorizontalContentAlignment="Center"  />
                </Border>

                <Button Name="Button_Settings" Grid.Column="0" Grid.Row="4" Content="Settings..." HorizontalAlignment="Left" Margin="4,4,4,4" VerticalAlignment="Center" Width="150" FontSize="14" Height="30" Click="Button_Click"  FontWeight="Bold"/>

                <Border Name="Border_Start" Grid.Column="1" Grid.Row="4" Background="White" CornerRadius="5"  BorderThickness="4,4,4,4" BorderBrush="Red"  Padding="5" Width="165"  Margin="5" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Name="Button_Start"  Content="Start" HorizontalAlignment="Center" Margin="0,0,0,0" VerticalAlignment="Center" Width="150" FontSize="14" Height="25"  FontWeight="Bold" Click="Button_Start_Click"/>
                </Border>
                <tb:TaskbarIcon IconSource="Icon_Red.ico" ToolTipText="SmartAgent AIR Process" Name="TasbarIcon"  NoLeftClickDelay="True" />
                <Image HorizontalAlignment="Left" Height="46" Margin="85,0,0,0" VerticalAlignment="Top" Width="214" Source="/Resources/UCDLogo.png"/>
            </Grid>
        </Border>
    </Viewbox>
</Window>
